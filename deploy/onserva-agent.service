[Unit]
Description=Onserva monitoring agent
Documentation=https://onserva.com
# Wait for real network connectivity, not just for the interface to exist.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onserva
Group=onserva

# The key lives here, readable by root and the agent's own user, nobody else.
EnvironmentFile=/etc/onserva/agent.env
ExecStart=/usr/local/bin/onserva-agent

# A monitoring agent that stays down is worse than useless. Always come back.
Restart=always
RestartSec=10

# ── Hardening ───────────────────────────────────────────────────────────────
# The agent needs to read a handful of world-readable files in /proc and make
# outbound HTTPS connections. Everything else is taken away from it. If it were
# ever compromised, this is the blast radius.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

# ── Resource ceiling ────────────────────────────────────────────────────────
# Onserva must never be the reason a server struggles. In practice the agent
# uses a few megabytes and a fraction of a percent of one core; these are the
# hard limits, not the expectation.
MemoryMax=64M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
